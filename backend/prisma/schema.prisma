generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  vi
  en
  ko
  ja
  zh
  zh_TW
  th
  lo
  km
  id
  ms
  fil
  hi
  ar
  ru
  pt
  it
  fr
  de
  es
}

enum PassStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ListeningMode {
  AUTO
  MANUAL
}

enum ListeningStatus {
  PREPARING
  PLAYING
  COMPLETED
  ERROR
  PAUSED
}

enum AccessSource {
  QR
  DIRECT
  MAP
  TOUR
}

enum PoiStatus {
  DRAFT
  PUBLISHED
}

model LanguageCatalog {
  code        String   @id
  nameVi      String
  nameEn      String
  nativeName  String
  flagEmoji   String
  isAvailable Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isAvailable])
  @@index([sortOrder])
}

model Poi {
  id                String             @id @default(cuid())
  name              String
  description       String
  latitude          Float
  longitude         Float
  category          String
  address           String?
  activationRadius  Int                @default(50)
  priority          Int                @default(0)
  imageUrl          String?
  status            PoiStatus          @default(PUBLISHED)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  narrations        Narration[]
  listeningEvents   ListeningEvent[]
  listeningSessions ListeningSession[]
  accessEvents      AccessEvent[]
  tourStops         TourStop[]
  qrCodes           QrCode[]

  @@index([status])
  @@index([priority])
  @@index([category])
}

model Narration {
  id              String   @id @default(cuid())
  poiId           String
  language        Language
  title           String
  content         String
  audioUrl        String?
  durationSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  poi             Poi      @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@unique([poiId, language])
  @@index([language])
  @@index([poiId])
}

model Tour {
  id               String     @id @default(cuid())
  name             String
  description      String?
  isSuggested      Boolean    @default(false)
  estimatedMinutes Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  stops            TourStop[]

  @@index([isSuggested])
}

model TourStop {
  id       String @id @default(cuid())
  tourId   String
  poiId    String
  position Int
  tour     Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  poi      Poi    @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@unique([tourId, position])
  @@unique([tourId, poiId])
  @@index([tourId])
  @@index([poiId])
}

model ListeningEvent {
  id              String          @id @default(cuid())
  visitorId       String?
  poiId           String
  language        Language
  mode            ListeningMode
  status          ListeningStatus @default(COMPLETED)
  latitude        Float?
  longitude       Float?
  durationSeconds Int?            @default(0)
  startedAt       DateTime        @default(now())
  endedAt         DateTime?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  poi             Poi             @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([poiId, createdAt])
  @@index([language, createdAt])
  @@index([status])
  @@index([visitorId, createdAt])
  @@index([startedAt])
}

model ListeningSession {
  id              String          @id @default(cuid())
  visitorId       String
  poiId           String
  language        Language
  mode            ListeningMode   @default(AUTO)
  status          ListeningStatus @default(PLAYING)
  startedAt       DateTime        @default(now())
  lastHeartbeatAt DateTime        @default(now())
  endedAt         DateTime?
  durationSeconds Int             @default(0)
  errorMessage    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  poi             Poi             @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([status])
  @@index([lastHeartbeatAt, status])
  @@index([poiId])
}

model AccessEvent {
  id         String       @id @default(cuid())
  visitorId  String
  ipAddress  String?
  userAgent  String?
  deviceType String?      @default("Mobile")
  language   Language     @default(vi)
  poiId      String?
  source     AccessSource @default(DIRECT)
  path       String?
  createdAt  DateTime     @default(now())
  poi        Poi?         @relation(fields: [poiId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([visitorId])
  @@index([poiId])
  @@index([language])
  @@index([source])
}

model QrCode {
  id            String    @id @default(cuid())
  code          String    @unique
  targetPoiId   String?
  targetTourId  String?
  defaultLang   Language  @default(vi)
  label         String?
  scanCount     Int       @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  poi           Poi?      @relation(fields: [targetPoiId], references: [id], onDelete: SetNull)

  @@index([targetPoiId])
  @@index([code])
}

model AccessPass {
  id          String     @id @default(cuid())
  code        String     @unique
  tourId      String?
  status      PassStatus @default(ACTIVE)
  expiresAt   DateTime?
  activatedAt DateTime?
  deviceInfo  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([expiresAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  actor      String   @default("admin")
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model VisitorSession {
  visitorId       String    @id
  passCode        String?
  language        Language  @default(vi)
  deviceInfo      String?
  lastActivePoiId String?
  latitude        Float?
  longitude       Float?
  isSpeaking      Boolean   @default(false)
  connectedAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  isActive        Boolean   @default(true)

  @@index([lastSeenAt, isActive])
}