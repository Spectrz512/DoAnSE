# ==============================================================================
# HỆ THỐNG THUYẾT MINH DI TÍCH - FILE CẤU HÌNH MẪU (.env.example)
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL (Mặc định Docker cục bộ)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/linh_ung?schema=public"

# Hoặc thay bằng Cloud PostgreSQL:
# DATABASE_URL="postgresql://user:password@ep-sample-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# 2. Khóa bảo mật & Admin API
JWT_SECRET="local-development-secret-change-me"
ADMIN_API_KEY="local-admin-key-change-me"

# 3. Cổng dịch vụ & CORS
PORT=3000
CORS_ORIGIN="*"

# 4. Địa chỉ IP Mạng LAN (tùy chọn)
# SERVER_LAN_IP="192.168.1.15"
